{
  "name": "patient-collab-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx src/server.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "tsx src/server.ts",
    "esheet:build": "cd ../../vendor/eSheet && (npm ci || npm install) && npx nx run-many -t build -p @esheet/core @esheet/renderer @esheet/builder",
    "ui:build": "cd ../../vendor/ui && pnpm install --frozen-lockfile && pnpm build",
    "e2e:server": "vite build && tsx src/server.ts",
    "test": "vitest run --passWithNoTests --root ../.. examples/patient-collab-demo",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@mieweb/ui": "link:../../vendor/ui",
    "@yorm/fhir": "workspace:*",
    "@yorm/yjs": "workspace:*",
    "example-fhir-patient-contacts": "workspace:*",
    "hono": "^4.6.11",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "sass": "^1.81.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
