{
  "name": "patient-collab-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx src/server.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "tsx src/server.ts",
    "e2e:server": "vite build && tsx src/server.ts",
    "test": "vitest run --passWithNoTests --root ../.. examples/patient-collab-demo",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@esheet/core": "0.0.3",
    "@esheet/fields": "0.0.3",
    "@esheet/renderer": "0.0.3",
    "@hono/node-server": "^1.13.7",
    "@mieweb/ui": "^0.6.1",
    "@yorm/fhir": "workspace:*",
    "example-fhir-patient-contacts": "workspace:*",
    "hono": "^4.6.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "sass": "^1.81.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
