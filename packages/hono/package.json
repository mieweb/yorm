{
  "name": "@yorm/hono",
  "version": "0.1.0",
  "description": "Hono transport adapter for YORM: mounts the HTTP document routes and the y-protocols WebSocket collaboration endpoint on any Hono app.",
  "keywords": [
    "yorm",
    "hono",
    "websocket",
    "yjs",
    "collaborative"
  ],
  "license": "MIT",
  "author": "Medical Informatics Engineering, Inc.",
  "homepage": "https://github.com/mieweb/yorm/tree/main/packages/hono#readme",
  "bugs": "https://github.com/mieweb/yorm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mieweb/yorm.git",
    "directory": "packages/hono"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests --root ../.. packages/hono"
  },
  "dependencies": {
    "@yorm/core": "workspace:*",
    "@yorm/server": "workspace:*",
    "@yorm/yjs": "workspace:*"
  },
  "peerDependencies": {
    "hono": "^4",
    "yjs": "^13"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/node-ws": "^1.0.4",
    "hono": "^4.13.11",
    "lib0": "^0.2.98",
    "typescript": "^5.6.3",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  }
}
